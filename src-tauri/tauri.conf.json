{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendário",
  "version": "0.1.0",
  "identifier": "com.personal.calendargadget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calendário",
        "width": 760,
        "height": 680,
        "minWidth": 360,
        "minHeight": 360,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": true,
        "skipTaskbar": false,
        "maximizable": true
      },
      {
        "label": "alarm",
        "url": "index.html?janela=alarme",
        "title": "Lembrete",
        "width": 430,
        "height": 280,
        "minWidth": 430,
        "minHeight": 280,
        "decorations": false,
        "transparent": false,
        "resizable": false,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "alwaysOnTop": true,
        "closable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 https://www.googleapis.com https://oauth2.googleapis.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' http://localhost:1420; script-src 'self' http://localhost:1420; font-src 'self' data:; media-src 'self' file: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "google-client.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
